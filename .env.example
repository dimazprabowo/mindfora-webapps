# Salin ke .env.production / .env.development lalu sesuaikan.
# Ganti URL = ubah file ini + `npm run sync` (atau `npm run sync:dev`) + build ulang APK.

# URL web Mindfora yang dibuka WebView (production WAJIB https).
MINDFORA_URL=https://mindfora.id

# Host tambahan (pisahkan koma) yang tetap dibuka DI DALAM app, mis. host SSO.
# Host lain di luar daftar ini otomatis dibuka di browser/app eksternal.
MINDFORA_ALLOW_NAVIGATION=
